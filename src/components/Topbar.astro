---
const { user } = Astro.locals;
---

<div class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80">
  {user ? (
    <>
      <span class="text-blue-100/70">{user.email}</span>
      <div class="flex items-center gap-3">
        <a href="/dashboard" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Miesiąc
        </a>
        <details class="relative">
          <summary class="cursor-pointer list-none text-purple-300 transition-colors hover:text-purple-100">
            Ustawienia
          </summary>
          <ul class="absolute right-0 z-10 mt-2 min-w-36 rounded-lg border border-white/10 bg-slate-900 p-1 shadow-lg">
            <li>
              <a
                href="/settings/categories"
                class="block rounded-md px-3 py-2 text-purple-300 transition-colors hover:bg-white/10 hover:text-purple-100"
              >
                Kategorie
              </a>
            </li>
          </ul>
        </details>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Wyloguj
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-blue-100/70">Niezalogowano</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Zaloguj się
        </a>
        <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Załóż konto
        </a>
      </div>
    </>
  )}
</div>
