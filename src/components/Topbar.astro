---
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

// RLS lets the caller read only their own household, so no filter is needed.
let householdName = "Hajsownik";
if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  const { data } = (await supabase?.from("households").select("name").maybeSingle()) ?? {};
  if (typeof data?.name === "string") householdName = data.name;
}

const path = Astro.url.pathname;
const links = [
  { href: "/dashboard", label: "Miesiąc" },
  { href: "/history", label: "Historia" },
];
const settingsLinks = [
  { href: "/settings/categories", label: "Kategorie" },
  { href: "/settings/recurring", label: "Cykliczne" },
];
const inSettings = path.startsWith("/settings");

const buttonClass = "flex min-h-11 items-center rounded-lg px-4 text-sm font-medium transition-colors";
const activeClass = "bg-purple-600 text-white";
const idleClass = "text-purple-300 hover:bg-white/10 hover:text-purple-100";
const itemClass =
  "block rounded-md px-3 py-2 text-purple-300 transition-colors hover:bg-white/10 hover:text-purple-100";
---

{user ? (
  <header class="relative mb-4">
    <div class="flex items-center justify-between gap-2 rounded-xl border border-white/10 bg-white/5 px-2 py-1 text-sm">
      <div class="flex min-w-0 items-center gap-1">
        <details class="sm:hidden">
          <summary
            aria-label="Menu"
            class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg text-purple-300 transition-colors hover:bg-white/10 hover:text-purple-100"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="4" x2="20" y1="12" y2="12"></line>
              <line x1="4" x2="20" y1="6" y2="6"></line>
              <line x1="4" x2="20" y1="18" y2="18"></line>
            </svg>
          </summary>
          <nav
            aria-label="Menu główne"
            class="absolute inset-x-0 top-full z-10 mt-1 flex flex-col gap-1 rounded-xl border border-white/10 bg-slate-900 p-2 shadow-lg"
          >
            {links.map((link) => (
              <a
                href={link.href}
                aria-current={path === link.href ? "page" : undefined}
                class:list={[buttonClass, "justify-start", path === link.href ? activeClass : idleClass]}
              >
                {link.label}
              </a>
            ))}
            <details open={inSettings} class="group">
              <summary
                class:list={[
                  buttonClass,
                  "cursor-pointer list-none justify-between",
                  inSettings ? activeClass : idleClass,
                ]}
              >
                Ustawienia
                <span aria-hidden="true" class="transition-transform group-open:rotate-180">
                  ▾
                </span>
              </summary>
              <div class="mt-1 flex flex-col gap-1 pl-4">
                {settingsLinks.map((link) => (
                  <a
                    href={link.href}
                    aria-current={path === link.href ? "page" : undefined}
                    class:list={[buttonClass, "justify-start", path === link.href ? activeClass : idleClass]}
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </details>
          </nav>
        </details>
        <span class="truncate px-2 font-medium text-white/90">{householdName}</span>
      </div>
      <form method="POST" action="/api/auth/signout">
        <button
          type="submit"
          class="flex min-h-11 items-center gap-2 rounded-lg px-3 text-purple-300 transition-colors hover:bg-white/10 hover:text-purple-100"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" x2="9" y1="12" y2="12"></line>
          </svg>
          Wyloguj
        </button>
      </form>
    </div>

    <nav
      aria-label="Menu główne"
      class="mx-auto mt-1 hidden w-full max-w-md gap-1 rounded-xl border border-white/10 bg-white/5 p-1 sm:flex"
    >
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? "page" : undefined}
          class:list={[buttonClass, "flex-1 justify-center", path === link.href ? activeClass : idleClass]}
        >
          {link.label}
        </a>
      ))}
      <details class="relative flex-1">
        <summary
          class:list={[buttonClass, "cursor-pointer list-none justify-center", inSettings ? activeClass : idleClass]}
        >
          Ustawienia ▾
        </summary>
        <ul class="absolute right-0 z-10 mt-2 min-w-48 rounded-lg border border-white/10 bg-slate-900 p-1 shadow-lg">
          {settingsLinks.map((link) => (
            <li>
              <a href={link.href} class:list={[itemClass]}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </header>
) : (
  <div class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80">
    <span class="text-blue-100/70">Niezalogowano</span>
    <div class="flex gap-3">
      <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        Zaloguj się
      </a>
      <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        Załóż konto
      </a>
    </div>
  </div>
)}
