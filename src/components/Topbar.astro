---
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

// RLS lets the caller read only their own household, so no filter is needed.
let householdName = "Hajsownik";
if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  const { data } = (await supabase?.from("households").select("name").maybeSingle()) ?? {};
  if (typeof data?.name === "string") householdName = data.name;
}

const path = Astro.url.pathname;
const links = [
  { href: "/dashboard", label: "Miesiąc" },
  { href: "/history", label: "Historia" },
];
const settingsLinks = [
  { href: "/settings/categories", label: "Kategorie" },
  { href: "/settings/recurring", label: "Cykliczne" },
];
const inSettings = path.startsWith("/settings");

// Visible keyboard focus, the same ring as ui/button.tsx.
const focusClass = "outline-none focus-visible:ring-3 focus-visible:ring-ring/50";
const buttonClass = `flex min-h-11 items-center rounded-lg px-4 text-sm font-medium transition-colors ${focusClass}`;
const activeClass = "bg-primary text-primary-foreground";
const idleClass = "text-link hover:bg-card hover:text-link-hover";
const itemClass = `block rounded-md px-3 py-2 text-link transition-colors hover:bg-card hover:text-link-hover ${focusClass}`;
---

{user ? (
  <header class="relative mb-4">
    <div class="flex items-center justify-between gap-2 rounded-xl border border-border bg-card px-2 py-1 text-sm">
      <div class="flex min-w-0 items-center gap-1">
        <details class="sm:hidden" data-topbar-menu>
          <summary
            aria-label="Menu"
            class:list={[
              "flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg transition-colors",
              idleClass,
              focusClass,
            ]}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="4" x2="20" y1="12" y2="12"></line>
              <line x1="4" x2="20" y1="6" y2="6"></line>
              <line x1="4" x2="20" y1="18" y2="18"></line>
            </svg>
          </summary>
          <nav
            aria-label="Menu główne"
            class="absolute inset-x-0 top-full z-10 mt-1 flex flex-col gap-1 rounded-xl border border-border bg-popover p-2 shadow-lg"
          >
            {links.map((link) => (
              <a
                href={link.href}
                aria-current={path === link.href ? "page" : undefined}
                class:list={[buttonClass, "justify-start", path === link.href ? activeClass : idleClass]}
              >
                {link.label}
              </a>
            ))}
            <details open={inSettings} class="group">
              <summary
                class:list={[
                  buttonClass,
                  "cursor-pointer list-none justify-between",
                  inSettings ? activeClass : idleClass,
                ]}
              >
                Ustawienia
                <span aria-hidden="true" class="transition-transform group-open:rotate-180">
                  ▾
                </span>
              </summary>
              <div class="mt-1 flex flex-col gap-1 pl-4">
                {settingsLinks.map((link) => (
                  <a
                    href={link.href}
                    aria-current={path === link.href ? "page" : undefined}
                    class:list={[buttonClass, "justify-start", path === link.href ? activeClass : idleClass]}
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </details>
          </nav>
        </details>
        <span class="truncate px-2 font-medium text-foreground">{householdName}</span>
      </div>
      <form method="POST" action="/api/auth/signout">
        <button
          type="submit"
          class:list={["flex min-h-11 items-center gap-2 rounded-lg px-3 transition-colors", idleClass, focusClass]}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" x2="9" y1="12" y2="12"></line>
          </svg>
          Wyloguj
        </button>
      </form>
    </div>

    <nav
      aria-label="Menu główne"
      class="mx-auto mt-1 hidden w-full max-w-md gap-1 rounded-xl border border-border bg-card p-1 sm:flex"
    >
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? "page" : undefined}
          class:list={[buttonClass, "flex-1 justify-center", path === link.href ? activeClass : idleClass]}
        >
          {link.label}
        </a>
      ))}
      <details class="relative flex-1" data-topbar-menu>
        <summary
          class:list={[buttonClass, "cursor-pointer list-none justify-center", inSettings ? activeClass : idleClass]}
        >
          Ustawienia ▾
        </summary>
        <ul class="absolute right-0 z-10 mt-2 min-w-48 rounded-lg border border-border bg-popover p-1 shadow-lg">
          {settingsLinks.map((link) => (
            <li>
              <a href={link.href} class:list={[itemClass]}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </header>
) : (
  <div class="mb-4 flex items-center justify-between rounded-xl border border-border bg-card px-4 py-2 text-sm text-muted-foreground">
    <span>Niezalogowano</span>
    <div class="flex gap-3">
      <a
        href="/auth/signin"
        class:list={["rounded-sm text-link transition-colors hover:text-link-hover hover:underline", focusClass]}
      >
        Zaloguj się
      </a>
      <a
        href="/auth/signup"
        class:list={["rounded-sm text-link transition-colors hover:text-link-hover hover:underline", focusClass]}
      >
        Załóż konto
      </a>
    </div>
  </div>
)}

<script>
  // Native <details> only toggles on its own <summary>; close the top-level menus on outside press, Esc and focus leaving.
  const menus = document.querySelectorAll<HTMLDetailsElement>("details[data-topbar-menu]");

  // pointerdown, not click: on iOS Safari a click on a non-interactive page background does not reach document.
  document.addEventListener("pointerdown", (event) => {
    if (!(event.target instanceof Node)) return;
    for (const menu of menus) {
      if (menu.open && !menu.contains(event.target)) menu.open = false;
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const menu of menus) {
      if (!menu.open) continue;
      const hadFocus = menu.contains(document.activeElement);
      menu.open = false;
      if (hadFocus) menu.querySelector<HTMLElement>(":scope > summary")?.focus();
    }
  });

  for (const menu of menus) {
    menu.addEventListener("focusout", (event) => {
      // A null relatedTarget (click on a non-focusable spot, alt-tab) must not close the menu; pointerdown handles clicks.
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
    });
  }
</script>
