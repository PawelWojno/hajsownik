---
import { formatZl, sample } from "@/lib/home-sample";

// Lens and list geometry in viewBox units (260 x 270). Everything inside the lens is clipped to its circle, so the
// rows are kept narrow enough to stay inside it.
const LENS = { x: 130, y: 130, r: 104 };
const BAR_X = 65;
const BAR_WIDTH = 130;
const ROW_PITCH = 38;
const lensRows = sample.categories.slice(0, 4).map((category, index) => ({
  ...category,
  y: 104 + index * 28,
  width: (category.amount / sample.categories[0].amount) * BAR_WIDTH,
}));
const entries = sample.entries.map((entry, index) => ({
  ...entry,
  y: 26 + index * ROW_PITCH,
  text: `${entry.amount > 0 ? "+" : ""}${formatZl(entry.amount)}`,
}));
const description = `Lupa nad listą wydatków pokazuje podział wydatków według kategorii (${lensRows
  .map((row) => `${row.name} ${formatZl(row.amount)}`)
  .join(", ")}); dane przykładowe`;
---

<div class="border-border bg-card flex h-full w-full flex-col gap-3 rounded-3xl border p-4">
  <h3 class="text-lg font-bold">Wgląd w budżet</h3>
  <svg viewBox="0 0 260 270" role="img" aria-label={description} class="min-h-0 w-full flex-1">
    <defs>
      <filter id="lens-blur">
        <feGaussianBlur stdDeviation="2.6"></feGaussianBlur>
      </filter>
      <clipPath id="lens-clip">
        <circle cx={LENS.x} cy={LENS.y} r={LENS.r}></circle>
      </clipPath>
      <linearGradient id="lens-ring" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" style="stop-color: var(--link)"></stop>
        <stop offset="1" style="stop-color: var(--primary)"></stop>
      </linearGradient>
    </defs>

    <g filter="url(#lens-blur)" opacity="0.55">
      <rect x="0.5" y="0.5" width="259" height="231" rx="14" class="fill-foreground/8 stroke-border"></rect>
      {entries.map((entry) => (
        <>
          <circle cx="16" cy={entry.y - 4} r="4.5" class:list={[entry.fill]}></circle>
          <text x="28" y={entry.y} class="fill-foreground" font-size="12">
            {entry.label}
          </text>
          <text x="244" y={entry.y} class="fill-foreground" font-size="12" font-weight="600" text-anchor="end">
            {entry.text}
          </text>
          <line x1="14" y1={entry.y + 12} x2="246" y2={entry.y + 12} class="stroke-border"></line>
        </>
      ))}
    </g>

    <g clip-path="url(#lens-clip)">
      <circle cx={LENS.x} cy={LENS.y} r={LENS.r} class="fill-popover"></circle>
      <text x={LENS.x} y="78" class="fill-muted-foreground" font-size="9" letter-spacing="1.4" text-anchor="middle">
        WYDATKI WG KATEGORII
      </text>
      {lensRows.map((row) => (
        <>
          <text x={BAR_X} y={row.y} class="fill-foreground" font-size="12" font-weight="600">
            {row.name}
          </text>
          <text x={BAR_X + BAR_WIDTH} y={row.y} class="fill-muted-foreground" font-size="12" text-anchor="end">
            {formatZl(row.amount)}
          </text>
          <rect x={BAR_X} y={row.y + 6} width={BAR_WIDTH} height="6" rx="3" class="fill-foreground/15"></rect>
          <rect x={BAR_X} y={row.y + 6} width={row.width} height="6" rx="3" class:list={[row.fill]}></rect>
        </>
      ))}
    </g>

    <g transform="translate(203,203) rotate(45)">
      <rect x="0" y="-9" width="56" height="18" rx="9" fill="url(#lens-ring)"></rect>
    </g>
    <circle cx={LENS.x} cy={LENS.y} r={LENS.r} fill="none" stroke="url(#lens-ring)" stroke-width="8"></circle>
  </svg>

  <div class="border-success/35 bg-success/10 rounded-2xl border p-3">
    <p class="text-success text-xs font-semibold tracking-widest uppercase">Zostaje</p>
    <p class="text-success text-3xl font-bold tabular-nums">{formatZl(sample.left)}</p>
    <div class="mt-2 flex items-center gap-2">
      <div class="border-border bg-card min-w-0 flex-1 rounded-lg border px-2 py-1">
        <p class="text-muted-foreground text-xs">Przychody</p>
        <p class="text-sm font-semibold tabular-nums">{formatZl(sample.income)}</p>
      </div>
      <span aria-hidden="true" class="text-foreground text-2xl leading-none font-bold">
        −
      </span>
      <span class="sr-only">minus</span>
      <div class="border-border bg-card min-w-0 flex-1 rounded-lg border px-2 py-1">
        <p class="text-muted-foreground text-xs">Wydatki</p>
        <p class="text-sm font-semibold tabular-nums">{formatZl(sample.expense)}</p>
      </div>
    </div>
  </div>
  <p class="text-muted-foreground text-xs">Dane przykładowe</p>
</div>
