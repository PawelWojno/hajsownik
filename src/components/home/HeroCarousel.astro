---
import FlowSlide from "@/components/home/FlowSlide.astro";
import LensSlide from "@/components/home/LensSlide.astro";
import PhoneSlide from "@/components/home/PhoneSlide.astro";

const titles = ["wpisywanie wydatku", "przepływ pieniędzy", "wgląd w budżet"];
const slideClass = "h-140 w-full flex-none snap-center";
const label = (index: number) => `${index + 1} z ${titles.length}: ${titles[index]}`;

// Visible keyboard focus, the same ring as ui/button.tsx and Topbar.
const focusClass = "outline-none focus-visible:ring-3 focus-visible:ring-ring/50";
const arrowClass = `border-input bg-background/70 text-foreground hover:bg-accent absolute top-1/2 z-10 flex size-8 -translate-y-1/2 items-center justify-center rounded-full border backdrop-blur-sm transition-colors ${focusClass}`;
---

<div
  data-carousel
  role="region"
  aria-roledescription="karuzela"
  aria-label="Podgląd aplikacji"
  class="mx-auto w-full max-w-105"
>
  {/* px-10: room for the 32 px arrows plus a gap on both sides, so slides never sit under them. */}
  <div class="relative px-10">
    <button
      type="button"
      hidden
      data-carousel-control
      data-carousel-prev
      aria-label="Poprzedni widok"
      class:list={[arrowClass, "left-0"]}
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
    </button>

    {/* Without JS the track is still a touch-scrollable scroll-snap strip showing the first slide. */}
    {/* A scrollable region must be keyboard-focusable (←/→ handled in the script). */}
    {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex */}
    <div
      data-carousel-track
      role="group"
      aria-label="Slajdy"
      tabindex="0"
      class:list={["flex snap-x snap-mandatory no-scrollbar overflow-x-auto rounded-xl", focusClass]}
    >
      <div role="group" aria-roledescription="slajd" aria-label={label(0)} class:list={[slideClass]}>
        <PhoneSlide />
      </div>
      <div role="group" aria-roledescription="slajd" aria-label={label(1)} class:list={[slideClass]}>
        <FlowSlide />
      </div>
      <div role="group" aria-roledescription="slajd" aria-label={label(2)} class:list={[slideClass]}>
        <LensSlide />
      </div>
    </div>
    {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}

    <button
      type="button"
      hidden
      data-carousel-control
      data-carousel-next
      aria-label="Następny widok"
      class:list={[arrowClass, "right-0"]}
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </button>
  </div>

  <div hidden data-carousel-control class="mt-2 flex justify-center gap-1">
    {titles.map((title, index) => (
      <button
        type="button"
        data-carousel-bar
        aria-label={`Widok ${index + 1} z ${titles.length}: ${title}`}
        aria-current={index === 0 ? "true" : "false"}
        class:list={["group relative h-6 w-10 rounded-sm", focusClass]}
      >
        <span class="bg-input group-aria-[current=true]:bg-link absolute inset-x-0 top-2.5 h-1 rounded-sm transition-colors motion-reduce:transition-none" />
      </button>
    ))}
  </div>
</div>

<script>
  // Arrows, bars and ←/→ scroll the scroll-snap track; the index is derived from scrollLeft, so touch swipes and
  // buttons stay in sync. Wrapping from the last slide to the first (and back) is deliberate.
  for (const root of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    const bars = [...root.querySelectorAll<HTMLElement>("[data-carousel-bar]")];
    if (!track || bars.length === 0) continue;
    // The controls only work with this script, so they stay hidden (and out of the tab order) until it runs.
    root.querySelectorAll("[data-carousel-control]").forEach((control) => {
      control.removeAttribute("hidden");
    });

    const count = bars.length;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    // `current` is the slide shown, or the one a running scroll is heading to, so a fast second click builds on the
    // target instead of a half-scrolled position. `pending` is that running scroll's target.
    let current = 0;
    let pending: number | null = null;
    let resizing = false;
    const render = () => {
      bars.forEach((bar, i) => {
        bar.setAttribute("aria-current", i === current ? "true" : "false");
      });
    };
    const go = (target: number) => {
      if (!track.clientWidth) return;
      pending = (target + count) % count;
      current = pending;
      render();
      track.scrollTo({ left: pending * track.clientWidth, behavior: reduceMotion.matches ? "auto" : "smooth" });
    };
    const sync = () => {
      if (resizing || !track.clientWidth) return;
      const shown = Math.round(track.scrollLeft / track.clientWidth);
      if (pending !== null) {
        if (shown !== pending) return;
        pending = null;
      }
      current = shown;
      render();
    };

    track.addEventListener("scroll", () => window.requestAnimationFrame(sync), { passive: true });
    // A touch or wheel gesture takes over from a running scroll.
    for (const type of ["pointerdown", "wheel"]) {
      track.addEventListener(
        type,
        () => {
          pending = null;
        },
        { passive: true },
      );
    }
    root.querySelector("[data-carousel-prev]")?.addEventListener("click", () => {
      go(current - 1);
    });
    root.querySelector("[data-carousel-next]")?.addEventListener("click", () => {
      go(current + 1);
    });
    bars.forEach((bar, i) => {
      bar.addEventListener("click", () => {
        go(i);
      });
    });
    track.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      go(current + (event.key === "ArrowLeft" ? -1 : 1));
    });
    // A resize changes the slide width: snap back to the current slide instead of stopping between two. The browser's
    // own re-snap fires scroll events with the old offset, so sync ignores them for a moment.
    window.addEventListener("resize", () => {
      resizing = true;
      track.scrollTo({ left: current * track.clientWidth, behavior: "auto" });
      window.setTimeout(() => {
        resizing = false;
      }, 150);
    });
  }
</script>
