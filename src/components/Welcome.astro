---
import HeroCarousel from "@/components/home/HeroCarousel.astro";
import Topbar from "@/components/Topbar.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

// Hero CTA geometry. cn() (tailwind-merge) lets it win over the size classes in buttonVariants; cva alone does not
// resolve conflicting utilities.
const cta = cn(buttonVariants({ variant: "default" }), "h-auto rounded-lg px-10 py-4 text-lg shadow-none");

const features = ["Czynsz, raty i subskrypcje wpisujesz raz i zapominasz.", "Historia wydatków zawsze pod ręką."];

// Visible keyboard focus, the same ring as ui/button.tsx and Topbar.
const focusClass = "outline-none focus-visible:ring-3 focus-visible:ring-ring/50";
const signinLink = cn(
  "flex min-h-11 items-center rounded-lg px-3 text-base font-medium text-link transition-colors hover:text-link-hover",
  focusClass,
);
---

<div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <div class="mx-auto flex max-w-6xl flex-col gap-12 px-4 py-16 sm:py-20 lg:grid lg:grid-cols-2 lg:items-center lg:gap-16 lg:py-24">
      <div class="text-center lg:text-left">
        <h1 class="from-title-from to-title-to mb-4 bg-gradient-to-r bg-clip-text text-5xl leading-tight font-bold text-transparent sm:text-6xl lg:text-7xl">
          Hajsownik
        </h1>
        <p class="text-foreground mb-4 text-2xl font-semibold sm:text-3xl">Wiesz, ile zostaje w tym miesiącu.</p>
        <p class="text-muted-foreground mb-8 text-lg">
          Wpisz wydatek w kilka sekund: kwota, kategoria, zapisz. Hajsownik od razu pokaże, ile zostaje z Twoich
          przychodów.
        </p>
        <ul class="mb-6 inline-flex flex-col gap-3 text-left text-base">
          {features.map((feature) => (
            <li class="text-foreground flex items-start gap-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="text-success mt-0.5 shrink-0"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {feature}
            </li>
          ))}
        </ul>
        <p class="text-muted-foreground mb-10 text-sm">
          Dane Twojego gospodarstwa są prywatne. Nikt spoza Twojego konta ich nie zobaczy.
        </p>
        <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start">
          <a href="/auth/signup" class:list={[cta]}>
            Załóż konto
          </a>
          <a href="/auth/signin" class:list={[signinLink]}>
            Zaloguj się
          </a>
        </div>
      </div>

      <HeroCarousel />
    </div>
  </div>
</div>
