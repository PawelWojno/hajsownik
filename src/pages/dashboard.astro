---
import MonthScreen from "@/components/month/MonthScreen";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import { currentMonthStart, formatMonthLabel, todayInWarsaw } from "@/lib/dates";
import { listActiveCategories } from "@/lib/services/categories";
import { getMonthSummary } from "@/lib/services/month";
import { listRecurringExpenses } from "@/lib/services/recurring-expenses";
import { createClient } from "@/lib/supabase";
import type { Category, MonthSummary, RecurringExpense } from "@/types";

let summary: MonthSummary | null = null;
let categories: Category[] = [];
let recurring: RecurringExpense[] = [];

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) {
  // The three reads are independent, so they run in parallel. The reminder list is optional: its failure must not
  // take the month screen down, and it is only used when the month data loaded (otherwise the screen shows an error).
  const [month, reminders] = await Promise.allSettled([
    Promise.all([listActiveCategories(supabase), getMonthSummary(supabase, currentMonthStart())]),
    listRecurringExpenses(supabase),
  ]);
  if (month.status === "fulfilled") {
    [categories, summary] = month.value;
    recurring = reminders.status === "fulfilled" ? reminders.value : [];
  }
}

const label = formatMonthLabel(todayInWarsaw());
const monthLabel = label.charAt(0).toUpperCase() + label.slice(1);
---

<Layout title="Hajsownik — miesiąc">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <Topbar />
    {summary ? (
      <MonthScreen
        monthLabel={monthLabel}
        initialSummary={summary}
        categories={categories}
        recurring={recurring}
        client:load
      />
    ) : (
      <p
        role="alert"
        class="mx-auto max-w-md rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300"
      >
        Nie udało się wczytać danych miesiąca. Odśwież stronę.
      </p>
    )}
  </div>
</Layout>
