---
import { z } from "zod";
import MonthScreen from "@/components/month/MonthScreen";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import { currentMonthStart, formatMonthLabel, todayInWarsaw } from "@/lib/dates";
import { getMonthSummary } from "@/lib/services/month";
import { createClient } from "@/lib/supabase";
import type { Category, MonthSummary } from "@/types";

const categoryRows = z.array(z.object({ id: z.string(), name: z.string() }));

let summary: MonthSummary | null = null;
let categories: Category[] = [];

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) {
  try {
    const { data, error } = await supabase
      .from("categories")
      .select("id, name")
      .is("archived_at", null)
      .order("sort_order");
    if (error) throw new Error(error.message);
    categories = categoryRows.parse(data);
    summary = await getMonthSummary(supabase, currentMonthStart());
  } catch {
    summary = null;
  }
}

const label = formatMonthLabel(todayInWarsaw());
const monthLabel = label.charAt(0).toUpperCase() + label.slice(1);
---

<Layout title="Hajsownik — miesiąc">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <Topbar />
    {summary ? (
      <MonthScreen monthLabel={monthLabel} initialSummary={summary} categories={categories} client:load />
    ) : (
      <p
        role="alert"
        class="mx-auto max-w-md rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300"
      >
        Nie udało się wczytać danych miesiąca. Odśwież stronę.
      </p>
    )}
  </div>
</Layout>
