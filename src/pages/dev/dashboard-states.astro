---
// Dev-only evidence page: the dashboard view in every state of the 7-state matrix, with static sample data.
// Rendered as static HTML (no client:load), so its buttons cannot call the API. Topbar reads the household name
// when a session exists. Outside `astro dev` it is a real HTTP 404.
import MonthScreen from "@/components/month/MonthScreen";
import { ServerError } from "@/components/auth/ServerError";
import Topbar from "@/components/Topbar.astro";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { DisabledSelectDemo } from "@/components/dev/DisabledSelectDemo";
import { AuthButtonDemo, AuthFieldDemo, AuthToggleDemo } from "@/components/dev/AuthStatesDemo";
import Layout from "@/layouts/Layout.astro";
import type { Category, MonthSummary, RecurringExpense, RecurringIncome } from "@/types";

// A real HTTP 404 outside dev (a top-level `return` in frontmatter crashes typescript-eslint, so the status is set here).
const enabled = import.meta.env.DEV;
if (!enabled) Astro.response.status = 404;

const categories: Category[] = [
  { id: "c1", name: "Jedzenie" },
  { id: "c2", name: "Transport" },
  { id: "c3", name: "Dom" },
];
const positive: MonthSummary = { incomeTotal: 520000, expenseTotal: 184550, left: 335450 };
const negative: MonthSummary = { incomeTotal: 100000, expenseTotal: 184550, left: -84550 };
const zero: MonthSummary = { incomeTotal: 0, expenseTotal: 0, left: 0 };
const recurring: RecurringExpense[] = [
  {
    id: "r1",
    categoryId: "c3",
    categoryName: "Dom",
    categoryArchived: false,
    amountMinor: 120000,
    dayOfMonth: 5,
    startMonth: "2025-11-01",
    endMonth: "2026-10-01",
    monthsLeft: 1,
    remind: true,
  },
];
const recurringIncomes: RecurringIncome[] = [
  {
    id: "i1",
    source: "wynagrodzenie",
    amountMinor: 520000,
    dayOfMonth: 10,
    startMonth: "2025-11-01",
    endMonth: "2026-10-01",
    monthsLeft: 0,
    remind: true,
  },
];
const historyHref = "/history";

// Forced states: the same token classes the real controls apply on :hover / :focus-visible, applied statically.
const forcedFocus = "border-ring ring-ring/50 ring-3";
---

<Layout title="Hajsownik — stany dashboardu (dev)">
  {!enabled ? (
    <p class="text-muted-foreground p-8 text-center text-sm">Nie znaleziono.</p>
  ) : (
    <div class="bg-cosmic min-h-screen p-4 sm:p-8">
      <h1 class="text-foreground mb-2 text-center text-2xl font-bold">Dashboard: macierz stanów (dev)</h1>
      <p class="text-muted-foreground mx-auto mb-2 max-w-2xl text-center text-sm">
        Strona tylko dla trybu dev, przykładowe dane statyczne.
      </p>
      <p class="text-muted-foreground mx-auto mb-8 max-w-2xl text-center text-sm">
        N/A: zalogowany Topbar (wymaga sesji), pusta siatka kategorii (widoczna tylko w otwartym panelu), fokus na polu
        „Źródło” i „Więcej opcji” (wymaga interakcji, sprawdzić Tabem na /dashboard). Kontrolki auth w stanie 6: N/A
        (formularz nie ma stanu pustych danych).
      </p>

      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 lg:grid-cols-2">
        <section aria-labelledby="st-default" class="flex flex-col gap-4">
          <h2 id="st-default" class="text-foreground text-lg font-semibold">
            1. default
          </h2>
          <p class="text-muted-foreground text-sm">
            Topbar (bez sesji pokazuje wariant niezalogowany) i ekran miesiąca z dodatnim "Zostaje". Statyczny HTML:
            przyciski są nieaktywne.
          </p>
          <Topbar />
          <MonthScreen
            monthLabel="Październik 2026"
            historyHref={historyHref}
            initialSummary={positive}
            categories={categories}
            recurring={recurring}
            recurringIncomes={recurringIncomes}
          />
          <p class="text-muted-foreground text-sm">Wariant ujemny ("Zostaje" poniżej zera):</p>
          <MonthScreen
            monthLabel="Wrzesień 2026"
            historyHref={historyHref}
            initialSummary={negative}
            categories={categories}
            recurring={[]}
            recurringIncomes={[]}
          />
          <p class="text-muted-foreground text-sm">Kontrolki auth:</p>
          <AuthFieldDemo state="default" />
          <AuthToggleDemo />
          <AuthButtonDemo state="default" />
        </section>

        <div class="flex flex-col gap-8">
          <section aria-labelledby="st-hover" class="flex flex-col gap-3">
            <h2 id="st-hover" class="text-foreground text-lg font-semibold">
              2. hover
            </h2>
            <p class="text-muted-foreground text-sm">Wymuszony stan (klasy). Prawdziwy hover: sprawdzić ręcznie.</p>
            <div class="flex flex-wrap items-center gap-3">
              <Button className="bg-primary-hover">Dodaj wydatek</Button>
              <Button variant="ghost" className="bg-accent text-accent-foreground">
                Nie przypominaj
              </Button>
              <Button variant="ghost" className="text-link-hover">
                Dodaj przychód
              </Button>
            </div>
            <AuthButtonDemo state="hover" />
          </section>

          <section aria-labelledby="st-focus" class="flex flex-col gap-3">
            <h2 id="st-focus" class="text-foreground text-lg font-semibold">
              3. focus-visible
            </h2>
            <p class="text-muted-foreground text-sm">Wymuszony stan (klasy). Prawdziwy focus: sprawdzić Tabem.</p>
            <div class="flex flex-wrap items-center gap-3">
              <Button className={forcedFocus}>Przedłuż</Button>
              <Button variant="ghost" className={`${forcedFocus} text-link`}>
                Dodaj przychód
              </Button>
            </div>
            <div>
              <Label htmlFor="focus-amount" className="text-muted-foreground mb-1 font-normal">
                Kwota (zł)
              </Label>
              <Input id="focus-amount" placeholder="0,00" className={`dark:bg-card ${forcedFocus}`} />
            </div>
            <AuthFieldDemo state="focus" />
            <AuthToggleDemo focus />
          </section>

          <section aria-labelledby="st-disabled" class="flex flex-col gap-3">
            <h2 id="st-disabled" class="text-foreground text-lg font-semibold">
              4. disabled
            </h2>
            <div class="flex flex-wrap items-center gap-3">
              <Button disabled>Dodaj wydatek</Button>
              <Button variant="ghost" disabled>
                Nie przypominaj
              </Button>
            </div>
            <div>
              <Label htmlFor="dis-amount" className="text-muted-foreground mb-1 font-normal">
                Kwota (zł)
              </Label>
              <Input id="dis-amount" disabled defaultValue="12,50" className="dark:bg-card" />
            </div>
            <div>
              <Label htmlFor="dis-source" className="text-muted-foreground mb-1 font-normal">
                Źródło
              </Label>
              <DisabledSelectDemo />
            </div>
            <AuthFieldDemo state="disabled" />
            <p class="text-muted-foreground text-sm">
              SubmitButton wyłącza się tylko w trakcie wysyłki: disabled = pending (ten sam wygląd co stan 7).
            </p>
            <AuthButtonDemo state="disabled" />
          </section>

          <section aria-labelledby="st-error" class="flex flex-col gap-3">
            <h2 id="st-error" class="text-foreground text-lg font-semibold">
              5. error
            </h2>
            <div>
              <Label htmlFor="err-amount" className="text-muted-foreground mb-1 font-normal">
                Kwota (zł)
              </Label>
              <Input id="err-amount" aria-invalid="true" defaultValue="abc" className="dark:bg-card" />
            </div>
            <ServerError message="Podaj poprawną kwotę" />
            <p
              role="alert"
              class="border-destructive/30 bg-destructive/15 text-destructive max-w-md rounded-lg border px-3 py-2 text-sm"
            >
              Nie udało się wczytać danych miesiąca. Odśwież stronę.
            </p>
            <AuthFieldDemo state="error" />
          </section>

          <section aria-labelledby="st-empty" class="flex flex-col gap-3">
            <h2 id="st-empty" class="text-foreground text-lg font-semibold">
              6. empty
            </h2>
            <p class="text-muted-foreground text-sm">Zerowe sumy, brak kategorii i przypomnień.</p>
            <MonthScreen
              monthLabel="Listopad 2026"
              historyHref={historyHref}
              initialSummary={zero}
              categories={[]}
              recurring={[]}
              recurringIncomes={[]}
            />
          </section>

          <section aria-labelledby="st-loading" class="flex flex-col gap-3">
            <h2 id="st-loading" class="text-foreground text-lg font-semibold">
              7. loading
            </h2>
            <p class="text-muted-foreground text-sm">
              Stan pending zapisu (statyczny disabled). N/A: szkielety (szkielety ładowania nie istnieją w aplikacji).
            </p>
            <Button disabled className="min-h-11 w-full rounded-lg">
              Zapisuję…
            </Button>
            <AuthButtonDemo state="loading" />
          </section>
        </div>
      </div>
    </div>
  )}
</Layout>
